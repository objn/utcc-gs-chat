API_TOKEN=your_jwt_token
TEST_USERNAME=your_username
TEST_PASSWORD=your_password
CHAT_WEBUI_BASE_URL=https://webhub.example.com/api

# ── PostgreSQL ──────────────────────────
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=appdb
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────
REDIS_PASSWORD=changeme_redis_password
REDIS_PORT=6379

# ── API (FastAPI) ────────────────────────
API_PORT=3000
API_SECRET_KEY=changeme_secret_key
DEBUG=false

# ── Facebook Graph API ──────────────────
FB_VERIFY_TOKEN=your_verify_token

# ── Frontend ────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── Internal URLs (ใช้ใน docker network) ─
# สำหรับ Docker: ใช้ hostname "postgres"
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ── Local dev (ไม่ใช้ Docker สำหรับ app) ─
# DATABASE_URL=postgresql+asyncpg://appuser:changeme_strong_password@localhost:5432/appdb
